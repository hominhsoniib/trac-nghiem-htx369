# URL of the deployed onluyen-auth-service backend (no trailing slash).
# In local dev this can stay unset — vite.config.js already proxies /api
# to http://localhost:4000. In production (Vercel) this MUST be set to
# the real backend URL, e.g. https://api.onluyen369.vn/api — Vercel only
# serves the static build and has no server to proxy /api to.
VITE_API_URL=http://localhost:4000/api

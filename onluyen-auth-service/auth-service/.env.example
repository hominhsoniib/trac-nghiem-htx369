# Server
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgres://onluyen_user:change_me@localhost:5432/onluyen

# JWT
JWT_ACCESS_SECRET=replace_with_long_random_string
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Cookies
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost

# Password reset (token TTL, minutes)
PASSWORD_RESET_TTL_MIN=60

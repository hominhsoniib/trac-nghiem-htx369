# Server
NODE_ENV=development
PORT=4000
# Comma-separated if you need more than one (rare) — must exactly match
# the frontend origin(s), e.g. https://trac-nghiem-weld.vercel.app
CORS_ORIGIN=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgres://onluyen_user:change_me@localhost:5432/onluyen

# JWT
JWT_ACCESS_SECRET=replace_with_long_random_string
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Cookies (refresh token)
# Local dev, same-site deployments:      COOKIE_SECURE=false COOKIE_SAME_SITE=lax
# Production, frontend on a DIFFERENT
# domain than the backend (e.g. Vercel
# frontend + VPS backend — the normal
# case here):                            COOKIE_SECURE=true  COOKIE_SAME_SITE=none
# SameSite=None is rejected by browsers unless Secure=true, so these two
# always change together.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Leave COOKIE_DOMAIN unset unless frontend and backend share a parent
# domain (both under *.onluyen369.vn, for example).
# COOKIE_DOMAIN=

# Password reset (token TTL, minutes)
PASSWORD_RESET_TTL_MIN=60
